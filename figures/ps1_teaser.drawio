<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="design" version="24.0.0" type="device">
  <diagram id="fig1-suu" name="Figure 1 — SUU framework">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#111111;strokeWidth=1.4;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="430" height="520" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;(a)&amp;nbsp; Fragmented provider-specific usage&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Different plans describe usage in incompatible ways&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#111111;strokeWidth=1.4;verticalAlign=middle;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="n3" value="" style="rounded=0;html=1;fillColor=#1B3A63;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="80" width="3" height="84" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Provider A&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;color:#3D3D3D&quot;&gt;$20 / month&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font style=&quot;font-size:12px;color:#1B3A63&quot;&gt;50,000 tokens per month&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px;color:#4A4A4A&quot;&gt;“Up to 50,000 tokens/month”&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="80" width="406" height="84" as="geometry"/></mxCell>
        <mxCell id="n5" value="" style="rounded=0;html=1;fillColor=#1B3A63;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="178" width="3" height="84" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Provider B&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;color:#3D3D3D&quot;&gt;$20 / month&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font style=&quot;font-size:12px;color:#1B3A63&quot;&gt;500 messages per month&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px;color:#4A4A4A&quot;&gt;“Includes 500 messages/month”&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="178" width="406" height="84" as="geometry"/></mxCell>
        <mxCell id="n7" value="" style="rounded=0;html=1;fillColor=#1B3A63;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="276" width="3" height="84" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Provider C&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;color:#3D3D3D&quot;&gt;$20 / month&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font style=&quot;font-size:12px;color:#1B3A63&quot;&gt;100 queries per week&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px;color:#4A4A4A&quot;&gt;“Up to 100 queries/week”&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="276" width="406" height="84" as="geometry"/></mxCell>
        <mxCell id="n9" value="" style="rounded=0;html=1;fillColor=#1B3A63;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="374" width="3" height="84" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;Provider D&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;color:#3D3D3D&quot;&gt;$20 / month&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font style=&quot;font-size:12px;color:#1B3A63&quot;&gt;128K context window&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px;color:#4A4A4A&quot;&gt;“Access to 128K context window”&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="374" width="406" height="84" as="geometry"/></mxCell>
        <mxCell id="n11" value="Same price, four incommensurable usage measures." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#4A4A4A;" vertex="1" parent="1"><mxGeometry x="32" y="484" width="406" height="20" as="geometry"/></mxCell>
        <mxCell id="n12" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#111111;strokeWidth=1.4;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="430" height="520" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;(b)&amp;nbsp; Vendor-neutral normalization&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Heterogeneous usage measures are converted into a common, comparable unit&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#111111;strokeWidth=1.4;verticalAlign=middle;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Computer science&lt;/b&gt; &lt;font style=&quot;color:#3D3D3D&quot;&gt;— workload normalization&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Map provider-specific measures to a common computational unit&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="80" width="406" height="58" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Economics&lt;/b&gt; &lt;font style=&quot;color:#3D3D3D&quot;&gt;— quality-adjusted comparison&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Account for differences in model capability and value&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="150" width="406" height="58" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;Behavioral science&lt;/b&gt; &lt;font style=&quot;color:#3D3D3D&quot;&gt;— consumer understanding&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Design clear, interpretable information for real-world choices&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="220" width="406" height="58" as="geometry"/></mxCell>
        <mxCell id="n17" style="endArrow=block;html=1;strokeColor=#111111;strokeWidth=1.4;endFill=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="292" as="sourcePoint"/><mxPoint x="685" y="308" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n18" value="&lt;b&gt;Standardized Usage Unit (SUU)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px;color:#DFE7F1&quot;&gt;A vendor-neutral unit for AI usage&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#1B3A63;strokeColor=#1B3A63;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="482" y="312" width="406" height="76" as="geometry"/></mxCell>
        <mxCell id="n19" value="Definition combines (i) normalized workload, (ii) quality adjustment, and (iii) a machine-readable reporting format." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="402" width="406" height="52" as="geometry"/></mxCell>
        <mxCell id="n20" value="Conversion values are illustrative and not yet empirically validated." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#4A4A4A;" vertex="1" parent="1"><mxGeometry x="482" y="484" width="406" height="20" as="geometry"/></mxCell>
        <mxCell id="n21" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#111111;strokeWidth=1.4;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="920" y="20" width="430" height="520" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;(c)&amp;nbsp; Three-stage consumer comparison&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Consumers evaluate plans through a structured three-stage experiment&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#111111;strokeWidth=1.4;verticalAlign=middle;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="20" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:9px;color:#1B3A63&quot;&gt;&lt;b&gt;STAGE 1&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;Original provider descriptions&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Plans shown as offered by providers (tokens, messages, limits).&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=center;spacingLeft=4;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="932" y="80" width="126" height="124" as="geometry"/></mxCell>
        <mxCell id="n24" style="endArrow=block;html=1;strokeColor=#111111;strokeWidth=1.4;endFill=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="142" as="sourcePoint"/><mxPoint x="1070" y="142" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:9px;color:#1B3A63&quot;&gt;&lt;b&gt;STAGE 2&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;Detailed capability and limit explanations&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Standardized explanations of what each plan includes and its limitations.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=center;spacingLeft=4;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1072" y="80" width="126" height="124" as="geometry"/></mxCell>
        <mxCell id="n26" style="endArrow=block;html=1;strokeColor=#111111;strokeWidth=1.4;endFill=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="142" as="sourcePoint"/><mxPoint x="1210" y="142" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:9px;color:#1B3A63&quot;&gt;&lt;b&gt;STAGE 3&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;SUU and SUU per dollar&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Plans displayed using SUU and SUU per dollar for direct comparison.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=center;spacingLeft=4;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1212" y="80" width="126" height="124" as="geometry"/></mxCell>
        <mxCell id="n28" style="endArrow=block;html=1;strokeColor=#111111;strokeWidth=1.4;endFill=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="208" as="sourcePoint"/><mxPoint x="1135" y="224" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Measured outcome: better comparison, transparency, and choice&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#3D3D3D&quot;&gt;Choice shifts across stages separate the effect of additional information from the effect of standardization itself.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="932" y="228" width="406" height="66" as="geometry"/></mxCell>
        <mxCell id="n30" value="Plans compared: ChatGPT Plus, Claude Pro, Google AI Pro, SuperGrok. Anticipated behavioral patterns, not obtained results." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="932" y="308" width="406" height="52" as="geometry"/></mxCell>
        <mxCell id="n31" value="Exactly one plan must be selected at each stage." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#4A4A4A;" vertex="1" parent="1"><mxGeometry x="932" y="484" width="406" height="20" as="geometry"/></mxCell>
        <mxCell id="n32" style="endArrow=block;html=1;strokeColor=#111111;strokeWidth=1.4;endFill=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452" y="300" as="sourcePoint"/><mxPoint x="468" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n33" style="endArrow=block;html=1;strokeColor=#111111;strokeWidth=1.4;endFill=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="902" y="300" as="sourcePoint"/><mxPoint x="918" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:9px;color:#1B3A63&quot;&gt;&lt;b&gt;SCOPE&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;SUU complements performance benchmarks and quality information; it does not imply identical service quality across models. Model quality, capabilities, and performance benchmarks remain essential and should be considered alongside SUU when evaluating plans." style="rounded=0;html=1;fillColor=none;strokeColor=#111111;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="556" width="1330" height="60" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Fig. 1.&lt;/b&gt; From heterogeneous AI usage measures to a standardized usage unit (SUU). (a) Provider plans at the same price describe usage in incompatible terms. (b) Computer science, economics, and behavioral science jointly define a vendor-neutral unit. (c) A three-stage web experiment tests whether standardized usage information improves comparison and choice." style="text;html=1;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="20" y="632" width="1180" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>